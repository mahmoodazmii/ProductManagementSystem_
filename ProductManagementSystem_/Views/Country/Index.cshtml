@{
    ViewBag.Title = "Country Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container-fluid mt-3">

    <div class="card shadow-sm mb-3">


        <div class="card-header bg-primary text-white">

            <h4 class="mb-0">   
                Country Master
            </h4>

        </div>

        <div class="card-body">

            <input type="hidden" id="CountryId" value="0" />

            <div class="row align-items-end">

                <div class="col-md-5">

                    <label>
                        <b>Country Name</b>
                    </label>

                    <input type="text" id="CountryName" class="form-control" placeholder="Enter Country Name" />

                </div>

                <div class="col-md-3">

                    <label>
                        <b>Status</b>
                    </label>

                    <select id="Status" class="form-control">

                        <option value="A">
                            Active
                        </option>

                        <option value="D">
                            Inactive
                        </option>

                    </select>

                </div>

                <div class="col-md-4 text-right">

                    <button type="button" id="btnSave" class="btn btn-success mr-2">

                        <i class="fa fa-save"></i> Save

                    </button>

                    <button type="button" id="btnReset" class="btn btn-secondary">

                        <i class="fa fa-refresh"></i> Reset

                    </button>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header country-list-header">

            <h5 class="mb-0"> Country List </h5>

        </div>

        <div class="card-body p-0">

            <table id="tblCountry" class="table table-bordered table-hover text-center mb-0">

                <thead>

                    <tr class="text-center">

                        <th style="width:8%"> Id </th>
                        <th> Country Name </th>
                        <th style="width:15%"> Status </th>
                        <th style="width:10%"> Edit </th>
                        <th style="width:10%"> Delete </th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .country-list-header {
        background-color: #add8e6 !important;
        color: #000 !important;
        font-weight: bold;
        width: 100%;
    }

    #tblCountry thead th {
        background: #343a40;
        color: white;
        text-align: center;
        vertical-align: middle;
    }

    #tblCountry tbody td {
        vertical-align: middle;
    }

    .text-right {
        text-align: right !important;
    }
</style>

@section scripts{

    <script src="~/Scripts/Country.js"></script>

}