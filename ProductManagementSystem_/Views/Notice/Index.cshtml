@{
    ViewBag.Title = "Notices";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
#noticeFormCard{
    width:100%;
}

#noticeFormCard .card{
    width:100%;
    border-radius:0;
}

#noticeFormCard .card-body{
    width:100%;
}

#noticeFormCard .row{
    margin-bottom:18px;
}

#noticeFormCard .col-12{
    flex:0 0 100%;
    max-width:100%;
}

#noticeFormCard input[type="text"],
#noticeFormCard textarea,
#noticeFormCard select{
    width:100% !important;
    max-width:100% !important;
    display:block;
    box-sizing:border-box;
}

#defaultPreview,
#coverContainer{

    height:300px;
    width:100%;

    border:1px solid #ddd;
    border-radius:5px;

    display:flex;
    justify-content:center;
    align-items:center;

    margin-top:15px;

}

#coverContainer{

    display:none;
    position:relative;

}

#CoverPreview{

    width:100%;
    height:100%;
    object-fit:cover;

}

#CoverImage{

    width:50% !important;

}

</style>

<div class="container-fluid px-0">

    <div class="d-flex justify-content-end mb-3">

        <button id="btnAddNew" class="btn btn-primary">

            <i class="fa fa-plus"></i>
            Add New Notice

        </button>

    </div>

    <div id="noticeFormCard" style="display:none;">

        <div class="card shadow">

            <div class="card-header bg-primary text-white">

                <h4 class="mb-0">
                    Notices
                </h4>

            </div>

            <div class="card-body">

                <input type="hidden"
                       id="NoticeId"
                       value="0" />

                <div class="row mb-3">

                    <div class="col-12">

                        <label>
                            Notice Topic
                        </label>

                        <input type="text" id="Topic"
                               class="form-control full-width-input"
                               placeholder="Enter topic" />

                    </div>

                </div>


                <div class="row mb-3">

                    <div class="col-12">

                        <div id="coverContainer">

                            <img id="CoverPreview"
                                 class="img-thumbnail" />

                            <button type="button"
                                    id="btnDeleteImage"
                                    class="btn btn-danger btn-sm"
                                    style="position:absolute;
                                           top:10px;
                                           right:10px;
                                           width:35px;
                                           height:35px;
                                           border-radius:50%;
                                           display:none;">

                                <i class="fa fa-times"></i>

                            </button>

                        </div>

                        <div id="defaultPreview">

                            IMAGE PREVIEW

                        </div>

                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-12">

                        <label>
                            Upload Cover Image
                        </label>

                        <input type="file"
                               id="CoverImage"
                               class="form-control"
                               accept="image/*" />

                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-12">

                        <label>
                            Notice Content
                        </label>

                        <textarea id="Content"
                                  class="form-control full-width-input"
                                  placeholder="Enter Notice Content"></textarea>

                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-12">

                        <label>
                            Status
                        </label>

                        <select id="Status"
                                class="form-select full-width-input">

                            <option value="true">
                                Active
                            </option>

                            <option value="false">
                                Inactive
                            </option>

                        </select>

                    </div>

                </div>

                <div class="text-center mt-4">

                    <button id="btnSave"
                            class="btn btn-success">

                        <i class="fa fa-save"></i>
                        Save

                    </button>

                    <button id="btnReset"
                            class="btn btn-secondary">

                        <i class="fa fa-refresh"></i>
                        Reset

                    </button>

                </div>

            </div>

        </div>

        <br />

    </div>

    <div class="card shadow"
         id="noticeListCard">

        <div class="card-header bg-dark text-white">

            <h5 class="mb-0">
                Notice List
            </h5>

        </div>

        <div class="card-body">

            <table class="table table-bordered table-hover table-striped text-center"
                   id="tblNotice">

                <thead class="table-primary">

                    <tr>

                        <th width="60"> ID </th>
                        <th width="120"> Image </th>
                        <th> Content </th>
                        <th width="200"> Action </th>

                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

    </div>

</div>

@section scripts{

    <script src="~/Scripts/Notice.js"></script>

}