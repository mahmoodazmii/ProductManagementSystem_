@model ProductManagementSystem_.ViewModels.DashboardViewModel

@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .dashboard-card {
        transition: .3s;
    }
        .dashboard-card:hover {
            transform: translateY(-5px);
        }

    .dashboard-icon {
        width: 55px;
        height: 55px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .card {
        border-radius: 12px;
    }
</style>

<div class="container-fluid">

    <div class="row">

        <div class="col-md-4 mb-3 dashboard-card">

            <a href="@Url.Action("Index","Product")"
               style="text-decoration:none;">

                <div class="card shadow-sm p-3 border-primary border-start border-4">

                    <div class="d-flex align-items-center">

                        <div class="dashboard-icon bg-primary text-white me-3">

                            <i class="fa fa-box"></i>

                        </div>

                        <div>

                           <h6 class="text-primary"> Total Products </h6>

                            <h2 class="text-dark">

                                @Model.TotalProducts

                            </h2>

                        </div>

                    </div>

                </div>

            </a>

        </div>

        <div class="col-md-4 mb-3 dashboard-card">

            <a href="@Url.Action("Index","Category")"
               style="text-decoration:none;">

                <div class="card shadow-sm p-3 border-success border-start border-4">

                    <div class="d-flex align-items-center">

                        <div class="dashboard-icon bg-success text-white me-3">

                            <i class="fa fa-folder"></i>

                        </div>

                        <div>

                            <h6 class="text-success"> Total Categories </h6>

                            <h2 class="text-dark">

                                @Model.TotalCategories

                            </h2>

                        </div>

                    </div>

                </div>

            </a>

        </div>

        <div class="col-md-4 mb-3 dashboard-card">

            <a href="@Url.Action("Index","Company")"
               style="text-decoration:none;">

                <div class="card shadow-sm p-3 border-warning border-start border-4">

                    <div class="d-flex align-items-center">

                        <div class="dashboard-icon bg-warning text-white me-3">

                            <i class="fa fa-building"></i>

                        </div>

                        <div>

                            <h6 class="text-warning"> Total Companies </h6>

                            <h2 class="text-dark">

                                @Model.TotalCompanies

                            </h2>

                        </div>

                    </div>

                </div>

            </a>

        </div>

    </div>

    <div class="row mt-4">

        <div class="col-md-8">

            <div class="card shadow-sm p-3">

                <h5 class="text-primary">

                    <i class="fa fa-clock"></i>

                    Recent Products

                </h5>

                <hr />

                <table class="table table-bordered table-hover">

                    <thead class="table-light">

                        <tr>
                            <th> Product </th>
                            <th> Category </th>
                            <th> Company </th>
                            <th> Price </th>

                       </tr>

                    </thead>

                    <tbody>

                        @if (Model.RecentProducts != null)
                        {

                            foreach (var item in Model.RecentProducts)
                            {

                                <tr>

                                    <td>
                                        @item.ProductName
                                    </td>

                                    <td>
                                        @item.Category
                                    </td>

                                    <td>
                                        @item.Company
                                    </td>

                                    <td>
                                        ₹ @item.SalePrice
                                    </td>

                                </tr>

                            }

                        }
                        else
                        {

                            <tr>

                                <td colspan="4" class="text-center"> No Product Found </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm p-3 mb-3">

                <h5 class="text-primary">

                    Recent Categories

                </h5>

                <hr />

                <ul class="list-group">

                    @if (Model.RecentCategories != null)
                    {

                        foreach (var item in Model.RecentCategories)
                        {

                            <li class="list-group-item">

                                @item

                            </li>

                        }

                    }

                </ul>

            </div>

            <div class="card shadow-sm p-3">

                <h5 class="text-primary">

                    Recent Companies

                </h5>

                <hr />

                <ul class="list-group">

                    @if (Model.RecentCompanies != null)
                    {

                        foreach (var item in Model.RecentCompanies)
                        {

                           <li class="list-group-item">

                                @item

                            </li>


                        }


                    }


                </ul>

            </div>

        </div>

    </div>

</div>